# ==========================================
# Production Environment Variables for Coolify
# ==========================================

# --- Django Security ---
SECRET_KEY=generate_a_long_random_string_here_50_chars
DEBUG=False
ALLOWED_HOSTS=api.yourdomain.com,your-server-ip
CSRF_TRUSTED_ORIGINS=https://api.yourdomain.com,https://crm.yourdomain.com

# --- Database ---
# If using Coolify's standalone PostgreSQL resource, paste its internal URL here:
DATABASE_URL=postgres://mintana_user:your_password@mintana-crm-db:5432/mintana_crm

# --- CORS & Origins ---
CORS_ALLOWED_ORIGINS=https://crm.yourdomain.com
CORS_ALLOW_ALL_ORIGINS=False

# --- Frontend Application URL (used in email links) ---
FRONTEND_URL=https://crm.yourdomain.com

# --- Brevo (Sendinblue) Email SMTP ---
BREVO_API_KEY=your_brevo_api_key_here
DEFAULT_FROM_EMAIL=mintanacrm@gmail.com
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USER=mintanacrm@gmail.com
SMTP_PASS=your_brevo_smtp_password_here

# --- Frontend Build Arg (in Coolify Frontend Application settings) ---
VITE_API_BASE_URL=https://api.yourdomain.com
